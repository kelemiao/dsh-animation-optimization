{
  "name": "dsh-animation-optimization",
  "version": "0.2.5",
  "description": "DSH 动画优化：输出流式动画与 Claude Code 风格外观插件",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "appearance",
    "animation",
    "claude-code",
    "vibe-coding",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelemiao/dsh-animation-optimization.git"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/client.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-store": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
